{
  "name": "website-editor",
  "version": "0.1.0",
  "description": "Browser-based inline website editor with side-by-side HTML source and an integrated terminal (works with Claude Code).",
  "main": "server/index.js",
  "bin": {
    "website-editor": "server/index.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js --open",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^5.65.21",
    "express": "^5.3.0",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
